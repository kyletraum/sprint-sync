<Project>

  <!-- Solution-wide build policy. Analyzers on, warnings meaningful:
       tenancy defects are the kind of bug a compiler can sometimes catch. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Audit only DIRECT dependencies. The one outstanding advisory (NU1903,
         Microsoft.OpenApi 2.0.0) is a TRANSITIVE dependency of
         Microsoft.AspNetCore.OpenApi 10.x with no compatible patched 2.x yet, so
         we cannot resolve it without a breaking 3.x jump. Making the exception
         explicit and auditable rather than incidental (P2-9); revisit when
         AspNetCore.OpenApi ships a fixed transitive. -->
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>

</Project>
