# Entra External ID (CIAM) — copy to .env.local and fill in for a live run.
# The integration test suite needs none of this.
VITE_ENTRA_AUTHORITY=https://<tenant>.ciamlogin.com/<tenant>.onmicrosoft.com
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_API_SCOPE=api://<api-client-id>/access_as_user

# Base URL of the Sprint Sync API. Left as a relative path, the Vite dev proxy
# forwards to the API that Aspire started.
VITE_API_BASE_URL=/api/v1
